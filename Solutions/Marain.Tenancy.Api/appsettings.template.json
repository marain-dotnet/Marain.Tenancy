{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TenantCacheConfiguration": {
    "CacheDuration": "00:05:00",
    "MaxCacheSize": 1000
  },
  "RootBlobStorageConfiguration": {
    "Container": "tenants",
    "ConnectionStringPlainText": "{{CONNECTION_STRING}}",
    "AccessKeyInKeyVault": {
      "VaultName": "{{KEY_VAULT_NAME}}",
      "SecretName": "{{SECRET_NAME}}",
      "VaultClientIdentity": {
        "ClientId": "{{CLIENT_ID}}",
        "ClientSecretInKeyVault": {
          "VaultName": "{{KEY_VAULT_NAME}}",
          "SecretName": "{{CLIENT_SECRET_NAME}}"
        }
      }
    },
    "DisableTenantValidation": false
  }
}